# RentFlow Production Environment Configuration
# Copy this file to .env on your production VPS
# File: .env.production.example
# IMPORTANT: This file must be in the same directory as docker-compose.production.yml

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=production

# ============================================
# REQUIRED - Must be set for production deployment
# ============================================

# Database Configuration (PostgreSQL)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_USER=rentflow_user
POSTGRES_DB=rentflow

# Flask Secret Key
# IMPORTANT: Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# ============================================
# SUPER ADMIN BOOTSTRAP (Optional but recommended)
# ============================================
# Create initial super admin account on first startup
# Remove these after first deployment if you prefer to create admins via web interface
# Password MUST meet admin requirements: 12+ chars, uppercase, lowercase, digit, special char

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_12CHARS
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# ============================================
# OPTIONAL - Has defaults in docker-compose.production.yml
# ============================================

# Gunicorn Settings (Production defaults: workers=4, threads=2, timeout=120)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Debug mode (MUST be False for production)
DEBUG=False

# Session security (MUST be True for production)
SESSION_COOKIE_SECURE=True

# ============================================
# MAIL CONFIGURATION (Optional but recommended)
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=alerts@yourdomain.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@rentflow.com

# ============================================
# AUTO-CONFIGURED - Set by docker-compose.production.yml
# ============================================
# These are automatically constructed from the variables above:
# - DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# - RATELIMIT_STORAGE_URL: redis://redis:6379/0

# ============================================
# PRODUCTION ENVIRONMENT NOTES
# ============================================
# - This is your PRODUCTION environment - handle with care
# - Runs on ports: 80 (HTTP), 443 (HTTPS), 8000 (Flask internal)
# - SSL/TLS via Cloudflare with Origin Certificates
# - Full security features enabled
# - Rate limiting enabled
# - Auto-deploys from 'main' branch via GitHub Actions

# ============================================
# DEPLOYMENT INFORMATION
# ============================================
# Location on VPS: /home/ubuntu/rentflow/
# Docker Compose: docker-compose.production.yml
# Deploy command: ./deploy.sh
# Logs: docker compose -f deployment/docker/docker-compose.yml logs -f
# Health check: curl https://yourdomain.com/health

# ============================================
# SECURITY CHECKLIST
# ============================================
# ✓ SECRET_KEY is randomly generated (not the default)
# ✓ POSTGRES_PASSWORD is strong and unique
# ✓ DEBUG=False
# ✓ SESSION_COOKIE_SECURE=True
# ✓ SSL certificates are in deployment/ssl/
# ✓ Firewall (ufw) is enabled
# ✓ Only ports 22, 80, 443 are open
# ✓ .env file is NOT committed to git
# ✓ Regular backups are automated
# ✓ Cloudflare proxy is enabled (orange cloud)
