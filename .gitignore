# Development scripts (local only)
create_demo_user.py

# Environment files (all environments)
.env
.env.local
.env.staging
.env.production
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Database files
*.db
*.sqlite
*.sqlite3

# Instance folder (ignore contents but track directory)
instance/*
!instance/.gitkeep
instance/demo_database.db  # Demo data database (local only)

# Flask session files
flask_session/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Claude Code local configuration
.claude/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs (ignore contents but track directory)
*.log
logs/*
!logs/.gitkeep

# Virtual environment
venv/
env/
ENV/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.eggreenv312/
reenv*/

# SSL Certificates - NEVER commit real certificates!
# Cloudflare origin certificates (production)
deployment/ssl/cloudflare-origin.crt
deployment/ssl/cloudflare-origin.key

# Any other certificate files
deployment/ssl/*.crt
deployment/ssl/*.key
deployment/ssl/*.pem

# NOTE: deployment/ssl/ directory itself is tracked (with .gitkeep)
# Certificates must be generated in Cloudflare Dashboard and installed manually

# Docker
docker-compose.override.yml
docker-compose.*.override.yml

# Uploads and media (ignore contents but track directory)
uploads/*
!uploads/.gitkeep
media/

# Backup files
*.backup
*.bak
backups/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
