# Environment files
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Database files
*.db
*.sqlite
*.sqlite3

# Instance folder (ignore contents but track directory)
instance/*
!instance/.gitkeep

# Flask session files
flask_session/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs (ignore contents but track directory)
*.log
logs/*
!logs/.gitkeep

# Virtual environment
venv/
env/
ENV/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.eggreenv312/
reenv*/

# SSL certificates (root location - old structure)
/ssl/

# NOTE: deployment/ssl/ contains self-signed dev certs (tracked)
# Production SSL certs should be managed externally (Let's Encrypt, etc.)

# Docker
docker-compose.override.yml

# Uploads and media (ignore contents but track directory)
uploads/*
!uploads/.gitkeep
media/

# Backup files
*.backup
*.bak
backups/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
