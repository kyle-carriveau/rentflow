# RentFlow Staging Environment Configuration
# Copy this file to .env.staging on your VPS staging environment
# File: .env.staging.example

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=staging

# ============================================
# DATABASE (Staging PostgreSQL)
# ============================================
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_STAGING_PASSWORD
POSTGRES_USER=rentflow_staging
POSTGRES_DB=rentflow_staging

# Constructed DATABASE_URL (automatically set by docker-compose.staging.yml)
# DATABASE_URL=postgresql://rentflow_staging:PASSWORD@db:5433/rentflow_staging

# ============================================
# FLASK CONFIGURATION
# ============================================
# IMPORTANT: Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_FOR_STAGING

# Debug mode (False for staging - mirrors production)
DEBUG=False

# Session security (True for staging)
SESSION_COOKIE_SECURE=True

# ============================================
# REDIS (For rate limiting)
# ============================================
# Automatically set by docker-compose.staging.yml
# RATELIMIT_STORAGE_URL=redis://redis:6380/0

# ============================================
# SUPER ADMIN BOOTSTRAP (Optional but recommended)
# ============================================
# Create initial super admin account on first startup
# Remove these after first deployment if you prefer to create admins via web interface
# Password MUST meet admin requirements: 12+ chars, uppercase, lowercase, digit, special char

INITIAL_ADMIN_USERNAME=staging_admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_12CHARS
INITIAL_ADMIN_EMAIL=admin@staging.yourdomain.com
INITIAL_ADMIN_FIRST_NAME=Staging
INITIAL_ADMIN_LAST_NAME=Admin

# ============================================
# GUNICORN (Staging)
# ============================================
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ============================================
# MAIL CONFIGURATION (Optional)
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=staging-alerts@yourdomain.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@staging.rentflow.com

# ============================================
# STAGING ENVIRONMENT NOTES
# ============================================
# - This is a TESTING environment - not for production use
# - Runs on same VPS as production but different ports
# - Staging URL: https://staging.yourdomain.com (port 8080/8443)
# - Separate database from production (rentflow_staging)
# - Used for QA and testing before production deployment
# - Auto-deploys from 'develop' branch via GitHub Actions

# ============================================
# DEPLOYMENT
# ============================================
# Location on VPS: /home/ubuntu/rentflow-staging/
# Docker Compose: docker-compose.staging.yml
# Ports: 8080 (HTTP), 8443 (HTTPS), 9000 (Flask), 5433 (PostgreSQL), 6380 (Redis)
# Deploy command: ./deploy-staging.sh
# Logs: docker compose -f docker-compose.staging.yml logs -f

# ============================================
# SECURITY NOTES
# ============================================
# - Use different SECRET_KEY from production
# - Use different database credentials from production
# - This environment should NOT contain production data
# - Test features here before promoting to production
