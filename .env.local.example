# RentFlow Local Development Environment Configuration
# Copy this file to .env.local and customize for your local setup
# File: .env.local.example

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=development

# ============================================
# DATABASE (Local PostgreSQL via Docker)
# ============================================
POSTGRES_PASSWORD=rentflow_dev_password
POSTGRES_USER=rentflow_dev
POSTGRES_DB=rentflow_dev

# Constructed DATABASE_URL (do not edit - automatically set by Docker)
DATABASE_URL=postgresql://rentflow_dev:rentflow_dev_password@localhost:5432/rentflow_dev

# ============================================
# FLASK CONFIGURATION
# ============================================
# Development secret key (NOT for production!)
SECRET_KEY=dev-secret-key-for-local-development-only

# Debug mode (keep True for local development)
DEBUG=True

# Session security (False for local development)
SESSION_COOKIE_SECURE=False

# ============================================
# REDIS (For rate limiting)
# ============================================
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# ============================================
# GUNICORN (Local Docker)
# ============================================
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ============================================
# MAIL CONFIGURATION (Optional)
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@rentflow-local.com

# ============================================
# LOCAL DEVELOPMENT NOTES
# ============================================
# - This environment uses Docker Compose with PostgreSQL
# - Database runs on localhost:5432 (exposed for DB tools)
# - Redis runs on localhost:6379
# - Hot reload is ENABLED for fast development
# - CSRF and security features are relaxed for development

# ============================================
# QUICK START
# ============================================
# 1. Copy this file: cp .env.local.example .env.local
# 2. Start Docker: make dev-up
# 3. Run migrations: make dev-migrate
# 4. Access app: http://localhost:5000
