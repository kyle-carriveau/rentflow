# ============================================================================

@pytest.fixture
def owner_user(db_session, company_a):
    """
    Owner role user for Company A.
    Full access to all features and data.
    """
    user = User(
        email='owner@alpha-properties.com',
        first_name='Alice',
        last_name='Owner',
        role='owner',
        company_id=company_a.id
    )
    user.set_password('OwnerPass123!', validate_policy=False)
    user.phone = '555-0201'

    db_session.session.add(user)
    db_session.session.commit()
    return user


