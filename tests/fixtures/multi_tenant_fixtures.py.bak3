"""
Multi-Tenant Test Fixtures

Comprehensive fixtures for testing multi-tenant isolation and role-based access control.
These fixtures create two separate companies with complete business object hierarchies
for testing data isolation.
"""

import pytest
import uuid
from datetime import datetime, timedelta
from website import db
from website.models import (
    Company, User, Portfolio, Property, Unit, Tenant, Lease,
    Payment, Expense
)


# ============================================================================
# COMPANY FIXTURES
# ============================================================================

@pytest.fixture
def company_a(db_session):
    """
    Test company A for multi-tenant isolation testing.
    Primary company for most tests.
    """
    company = Company(
        name='Alpha Properties LLC',
        email='contact@alpha-properties.com',
        phone='555-0200',
        address='100 Alpha Drive',
        city='Los Angeles',
        state='CA',
        zip_code='90001'
    )
    db_session.session.add(company)
    db_session.session.commit()
    return company


@pytest.fixture
def company_b(db_session):
    """
    Test company B for multi-tenant isolation testing.
    Used to verify Company A cannot access Company B's data.
    """
    company = Company(
        name='Beta Realty Group',
        email='info@beta-realty.com',
        phone='555-0300',
        address='200 Beta Boulevard',
        city='San Francisco',
        state='CA',
        zip_code='94102'
    )
    db_session.session.add(company)
    db_session.session.commit()
    return company


