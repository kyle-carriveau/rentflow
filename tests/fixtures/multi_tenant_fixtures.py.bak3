@pytest.fixture
def active_lease_a(db_session, company_a, property_a, unit_a, tenant_a):
    """
    Active lease for Company A linking unit_a and tenant_a.
    """
    today = datetime.now()
    lease = Lease(
        tenant_id=tenant_a.id,
        unit_id=unit_a.id,
        property_id=property_a.id,
        company_id=company_a.id,
        start=today - timedelta(days=30),  # Started 30 days ago
        end=today + timedelta(days=335),   # Ends in ~11 months
        rent=2500.00  # Float for SQLite compatibility
    )
    # Set additional attributes after creation
    lease.deposit = 2500.00  # Float for SQLite compatibility
    lease.lease_status = 'Active'
    lease.payment_frequency = 'Monthly'

    db_session.session.add(lease)
    db_session.session.commit()

    # Update unit occupancy status
    unit_a.occupancy_status = 'Occupied'
    db_session.session.commit()

    return lease


