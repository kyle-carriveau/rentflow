# RentFlow Environment Configuration for Docker Compose
# Copy this file to .env and fill in your actual values
# IMPORTANT: This file must be in the same directory as docker-compose.yml

# ============================================
# REQUIRED - Must be set for deployment
# ============================================

# Database Configuration (PostgreSQL)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_USER=rentflow_user
POSTGRES_DB=rentflow

# Flask Secret Key (generate with: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# ============================================
# OPTIONAL - Has defaults in docker-compose.yml
# ============================================

# Gunicorn Settings (defaults: workers=4, threads=2, timeout=120)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ============================================
# AUTO-CONFIGURED - Set by docker-compose.yml
# ============================================
# These are automatically constructed from the variables above:
# - DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# - RATELIMIT_STORAGE_URL: redis://redis:6379/0
# - FLASK_ENV: production
# - DEBUG: False
# - SESSION_COOKIE_SECURE: True
